# Copy to .env and fill in. Never commit .env.

# --- Snowflake (run snowflake/01_setup.sql first) ---
SNOWFLAKE_ACCOUNT=myorg-myaccount          # Snowsight: bottom-left menu > your account > "Copy account identifier"

# Sign-in option A (quick start, trial accounts): your own Snowflake login and password.
# Trial accounts are exempt from Snowflake's MFA rollout. The app still connects as the read-only
# DATAMIND_AGENT role with secondary roles off, so your admin rights never apply to its queries.
SNOWFLAKE_USER=your_login_name
SNOWFLAKE_PASSWORD=

# Sign-in option B (any account, recommended for long-lived setups): the DATAMIND_APP service user with a
# key pair. Run `python scripts/make_keypair.py`, run the ALTER USER it prints, then use these instead of A:
# SNOWFLAKE_USER=DATAMIND_APP
# SNOWFLAKE_PRIVATE_KEY_FILE=keys/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=        # only if you used --passphrase

SNOWFLAKE_ROLE=DATAMIND_AGENT
SNOWFLAKE_WAREHOUSE=DATAMIND_WH
SNOWFLAKE_DATABASE=DATAMIND_DB
SNOWFLAKE_SCHEMA=TPCH

# --- Gemma ---
# Two ways to run Gemma (open weights; non-Gemma models are rejected by the code):
#  ollama: local and free (default).  ollama pull gemma4:12b  (16 GB RAM)  or  gemma4:31b  (32 GB+ RAM)
#  hf:     Gemma 4 31B via Hugging Face Inference Providers; needs HF_TOKEN with the
#          "Make calls to Inference Providers" permission and HF credits (~$0.14/M input, $0.40/M output tokens)
GEMMA_BACKEND=ollama
GEMMA_MODEL=gemma4:12b                     # hf: google/gemma-4-31B-it
# HF_TOKEN=
# HF_PROVIDER=novita                       # optional: pin a provider (novita, deepinfra); default: Hugging Face picks
# OLLAMA_HOST=http://localhost:11434
GEMMA_THINKING=1                           # 1 = Gemma reasons before writing plans/SQL (slower, more accurate)
GEMMA_TIMEOUT_S=120                        # per-request timeout for the hf backend

# --- DataMind ---
DATAMIND_ENGINE=snowflake                  # duckdb = offline development only (not for judging)
DATAMIND_DATASET=config/datasets/tpch.yaml
DATAMIND_MAX_ROWS=1000
# DATAMIND_DUCKDB_DATA=data/tpch_sf0_01
