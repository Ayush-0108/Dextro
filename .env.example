# Copy to .env and fill in. Never commit .env.

# --- Snowflake (run snowflake/01_setup.sql first) ---
SNOWFLAKE_ACCOUNT=myorg-myaccount          # from Snowsight: Admin > Accounts, or the account URL
SNOWFLAKE_USER=DATAMIND_APP                # or your own user
SNOWFLAKE_PASSWORD=                        # trial accounts allow password sign-in
# SNOWFLAKE_PRIVATE_KEY_FILE=keys/rsa_key.p8   # key-pair auth (recommended on paid accounts)
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=DATAMIND_AGENT
SNOWFLAKE_WAREHOUSE=DATAMIND_WH
SNOWFLAKE_DATABASE=DATAMIND_DB
SNOWFLAKE_SCHEMA=TPCH

# --- Gemma ---
GEMMA_BACKEND=api                          # api = Gemini API (free key: https://aistudio.google.com/apikey) | ollama = local
GEMMA_MODEL=gemma-4-31b-it                 # api: gemma-4-31b-it or gemma-4-26b-a4b-it | ollama: gemma4:26b, gemma4:31b
GEMINI_API_KEY=
# OLLAMA_HOST=http://localhost:11434
GEMMA_THINKING=1                           # 1 = Gemma reasons before writing plans/SQL (slower, more accurate)

# --- DataMind ---
DATAMIND_ENGINE=snowflake                  # duckdb = offline development only (not for judging)
DATAMIND_DATASET=config/datasets/tpch.yaml
DATAMIND_MAX_ROWS=1000
# DATAMIND_DUCKDB_DATA=data/tpch_sf0_01
